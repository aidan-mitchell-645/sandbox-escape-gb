; ===========================================================================
; Level data structures
;
; Each LevelNData:
;   DB numZones, numVulns
;   DW ZoneTablePtr
;   DW AdjTablePtr
;   ; numVulns vuln entries: DB zone, row, col
;   ; numVulns exploit entries: DB zone, row, col
;   DB startZone, startX, startY
; ===========================================================================

; Level 0 (original 6-zone level)
Level0Data:
    DB 6, 3
    DW ZoneTable
    DW ZoneAdjTable
    ; Vuln 0: zone 0, row 5, col 14 (pixel X=112 Y=40)
    DB 0, 5, 14
    ; Vuln 1: zone 3, row 5, col 10 (pixel X=80 Y=40)
    DB 3, 5, 10
    ; Vuln 2: zone 4, row 5, col 8  (pixel X=64 Y=40)
    DB 4, 5, 8
    ; Exploit 0 spawns in zone 5, col 7, row 2
    DB 5, 2, 7
    ; Exploit 1 spawns in zone 2, col 7, row 4
    DB 2, 4, 7
    ; Exploit 2 spawns in zone 1, col 9, row 5
    DB 1, 5, 9
    ; Start: zone 0, X=16, Y=64
    DB 0, 16, 64

; Level 1
Level1Data:
    DB 4, 2
    DW L1ZoneTable
    DW L1AdjTable
    ; Vuln A: zone 1, row 5, col 9
    DB 1, 5, 9
    ; Vuln B: zone 3, row 5, col 15
    DB 3, 5, 15
    ; Exploit A spawns in zone 2, col 9, row 4
    DB 2, 4, 9
    ; Exploit B spawns in zone 0, col 9, row 4
    DB 0, 4, 9
    DB 0, 16, 64

; Level 2
Level2Data:
    DB 4, 2
    DW L2ZoneTable
    DW L2AdjTable
    ; Vuln A: zone 1, row 5, col 8
    DB 1, 5, 8
    ; Vuln B: zone 3, row 5, col 13
    DB 3, 5, 13
    ; Exploit A spawns in zone 2, col 9, row 4
    DB 2, 4, 9
    ; Exploit B spawns in zone 0, col 9, row 4
    DB 0, 4, 9
    DB 0, 16, 64

; Level 3
Level3Data:
    DB 4, 2
    DW L3ZoneTable
    DW L3AdjTable
    ; Vuln A: zone 1, row 5, col 5
    DB 1, 5, 5
    ; Vuln B: zone 3, row 5, col 10
    DB 3, 5, 10
    ; Exploit A spawns in zone 2, col 9, row 4
    DB 2, 4, 9
    ; Exploit B spawns in zone 0, col 9, row 4
    DB 0, 4, 9
    DB 0, 16, 64

; Level 4
Level4Data:
    DB 4, 2
    DW L4ZoneTable
    DW L4AdjTable
    ; Vuln A: zone 1, row 5, col 8
    DB 1, 5, 8
    ; Vuln B: zone 3, row 5, col 14
    DB 3, 5, 14
    ; Exploit A spawns in zone 2, col 9, row 4
    DB 2, 4, 9
    ; Exploit B spawns in zone 0, col 9, row 4
    DB 0, 4, 9
    DB 0, 16, 64

; Master level pointer table
LevelTable:
    DW Level0Data
    DW Level1Data
    DW Level2Data
    DW Level3Data
    DW Level4Data
